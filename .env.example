# Banco local (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cruzeiro
POSTGRES_PORT=5432

# Portas publicadas em 127.0.0.1
API_PORT=8000
PGWEB_PORT=8081

# API fora do Docker (make check, testes), sempre com a role restrita. No container, o Compose monta a URL para o serviço db.
APP_DATABASE_URL=postgresql+asyncpg://api:api@127.0.0.1:5432/cruzeiro
# Oráculo SQL dos testes e do eval: administrador, porque lê tabelas que a role não vê. A API nunca usa esta URL.
APP_ORACLE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/cruzeiro

# Provedor de LLM
OPENAI_API_KEY=

# Tracing com langfuse cloud (opicional)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Senha da role restrita da API no banco, lida pelo script de role na criação do volume
API_DB_PASSWORD=api

# Agente
APP_AGENT_MODEL=gpt-6-luna
APP_AGENT_EFFORT=low
APP_AGENT_MODEL_CALL_LIMIT=8
APP_AGENT_TOOL_CALL_LIMIT=12
APP_AGENT_TIMEOUT_SECONDS=60
APP_AGENT_MAX_CONCURRENCY=8
APP_HISTORY_WINDOW=20

# Identidade (JWT) e login simulado
APP_JWT_SECRET=
APP_JWT_TTL_MINUTES=60
APP_DEV_LOGIN=false

# Proposta de protocolo assinada
APP_PROPOSAL_SECRET=
APP_PROPOSAL_TTL_MINUTES=15

# Origens do front liberadas no CORS, em JSON
APP_CORS_ORIGINS=["http://localhost:5173"]
