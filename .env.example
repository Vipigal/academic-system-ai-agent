# Provedor de LLM: a única linha a preencher para rodar. Cole aqui a sua chave da OpenAI.
OPENAI_API_KEY=

# Segredos de exemplo, com 32 bytes ou mais, para rodar na hora. Troque os dois antes de expor a API fora da sua máquina.
APP_JWT_SECRET=exemplo-jwt-troque-antes-de-publicar-0123456789
APP_PROPOSAL_SECRET=exemplo-proposta-troque-antes-de-publicar-0123456789

# Login simulado, sem senha, escolhendo um aluno da base. Só para desenvolvimento e avaliação.
APP_DEV_LOGIN=true

# Origens do front liberadas no CORS, em JSON
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Rate limit por aluno no chat. No Docker, o Compose preenche a URL do serviço redis; vazio fora dele, o limite fica desligado.
APP_REDIS_URL=
APP_CHAT_RATE_LIMIT_PER_HOUR=60

# Pool de conexões do banco, por processo da API
APP_DB_POOL_SIZE=20
APP_DB_MAX_OVERFLOW=10
APP_DB_POOL_TIMEOUT_SECONDS=5

# Tracing com Langfuse Cloud (opcional): descomente e preencha para ver os traces.
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Banco local (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cruzeiro
POSTGRES_PORT=5432

# Senha da role restrita da API no banco, lida pelo script de role na criação do volume
API_DB_PASSWORD=api

# Portas publicadas em 127.0.0.1
API_PORT=8000
REDIS_PORT=6379
PGWEB_PORT=8081

# API fora do Docker (make check, testes), sempre com a role restrita. No container, o Compose monta a URL para o serviço db.
APP_DATABASE_URL=postgresql+asyncpg://api:api@127.0.0.1:5432/cruzeiro
# Oráculo SQL dos testes e do eval: administrador, porque lê tabelas que a role não vê. A API nunca usa esta URL.
APP_ORACLE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/cruzeiro

# Agente
APP_AGENT_MODEL=gpt-6-luna
APP_AGENT_EFFORT=low
APP_AGENT_MODEL_CALL_LIMIT=8
APP_AGENT_TOOL_CALL_LIMIT=12
APP_AGENT_TIMEOUT_SECONDS=60
APP_AGENT_MAX_CONCURRENCY=8
APP_HISTORY_WINDOW=20

# Validade dos tokens, em minutos
APP_JWT_TTL_MINUTES=60
APP_PROPOSAL_TTL_MINUTES=15
